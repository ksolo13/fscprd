# Copy to /opt/mos/brokermaster/.env and chmod 600. Never commit the real file.
# Oracle (SID):          oracle+oracledb://USER:PASSWORD@HOST:1526/SID
# Oracle (service name): oracle+oracledb://USER:PASSWORD@HOST:1526/?service_name=SERVICE
# SQL Server:            mssql+pyodbc://USER:PASSWORD@HOST:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server
# URL-encode special characters in the password (e.g. @ -> %40).
DB_URL=oracle+oracledb://USER:PASSWORD@HOST:1526/SID

# Optional overrides (defaults shown)
BROKER_SRC_DIR=/usr/local/mos/brokerinformation
BROKER_SRC_FILE=Master Broker Channel List.XLSX
BROKER_LOG_DIR=/var/log/mos
BROKER_TABLE=BROKERMASTER
# identity | max | <sequence expression, e.g. BROKERMASTER_SEQ.NEXTVAL>
BROKER_ID_MODE=identity
