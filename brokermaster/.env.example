# Copy to /opt/mos/brokermaster/.env and chmod 600. Never commit the real file.
# Values are in single quotes because the file is sourced by the shell (spaces, &, $ would break it).
# URL-encode special characters in the password: @ -> %40  # -> %23  / -> %2F  : -> %3A  % -> %25
#
# SQL Server (SQL login), ODBC Driver 18:
DB_URL='mssql+pyodbc://BROKER_LOADER:MyP%40ssw0rd@sqlprod01.bank.local:1433/MOSDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes'
# Named instance instead of port:  ...@sqlprod01.bank.local\MOSINST/MOSDB?driver=...
# Oracle alternative:              oracle+oracledb://USER:PASSWORD@HOST:1526/SID

# Optional overrides (defaults shown)
BROKER_SRC_DIR='/usr/local/mos/brokerinformation'
BROKER_SRC_FILE='Master Broker Channel List.XLSX'
BROKER_LOG_DIR='/var/log/mos'
BROKER_TABLE='dbo.BROKERMASTER'
# identity | max | NEXT VALUE FOR dbo.BROKERMASTER_SEQ
BROKER_ID_MODE='identity'
