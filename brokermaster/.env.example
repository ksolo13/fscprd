# Copy to /opt/mos/brokermaster/.env, then: chmod 600 .env
# Values are in single quotes because the file is sourced by the shell (; & $ and spaces would break it).
# Never commit the real file.

# SQL Server JDBC URL (Microsoft JDBC driver). Remove trustServerCertificate=true if the server has a CA-signed certificate.
DB_URL='jdbc:sqlserver://sqlprod01.bank.local:1433;databaseName=MOSDB;encrypt=true;trustServerCertificate=true'
# Named instance instead of port:  jdbc:sqlserver://sqlprod01.bank.local;instanceName=MOSINST;databaseName=MOSDB;...
DB_USER='BROKER_LOADER'
DB_PASSWORD='MyP@ssw0rd'

# Only needed if Java 8 is not at /usr/java/jre1.8.0_291-amd64 or /usr/java/jdk1.8.0_291-amd64
# JAVA_BIN='/usr/java/jre1.8.0_291-amd64/bin/java'

# Optional overrides (defaults shown)
BROKER_SRC_DIR='/usr/local/mos/brokerinformation'
BROKER_SRC_FILE='Master Broker Channel List.XLSX'
BROKER_LOG_DIR='/var/log/mos'
# Keep archive + last-load marker with the app, so the source folder only needs read access
BROKER_ARCHIVE_DIR='/opt/mos/brokermaster/archive'
BROKER_STATE_FILE='/opt/mos/brokermaster/.last_loaded.sha256'
BROKER_TABLE='dbo.BROKERMASTER'
# identity | max | NEXT VALUE FOR dbo.BROKERMASTER_SEQ
BROKER_ID_MODE='identity'
# Stamped with the run time on inserted and changed rows (unchanged rows keep their value).
# Set only after the DBA has added the column; leave empty to turn off.
BROKER_MODIFIED_COLUMN='DATEMODIFIED'
