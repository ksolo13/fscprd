<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Dashboard" Height="660" Width="1040"
        WindowStartupLocation="CenterScreen" Background="#2D2D30">
  <DockPanel>
    <ToolBar DockPanel.Dock="Top" Background="#3E3E42">
      <Button x:Name="BtnRunSelected" Content="Run Selected" Padding="10,4" Margin="2"/>
      <Button x:Name="BtnRunAll" Content="Run All" Padding="10,4" Margin="2"/>
      <Button x:Name="BtnStop" Content="Stop" Padding="10,4" Margin="2" IsEnabled="False"/>
      <Separator/>
      <Button x:Name="BtnReload" Content="Reload Tasks" Padding="10,4" Margin="2"/>
      <Button x:Name="BtnOpenLogs" Content="Open Logs" Padding="10,4" Margin="2"/>
      <Separator/>
      <CheckBox x:Name="ChkStopOnFail" Content="Stop on first failure" IsChecked="True"
                Foreground="#DCDCDC" VerticalAlignment="Center" Margin="6,0"/>
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom" Background="#007ACC">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" Foreground="White"/></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" MinWidth="260"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="TaskList" Margin="8"/>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#555"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Output" Margin="8,8,8,2" FontWeight="Bold" Foreground="#DCDCDC"/>
        <TextBox x:Name="Output" Grid.Row="1" Margin="8,0,8,8" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12.5" Padding="6"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Background="#1E1E1E" Foreground="#DCDCDC"
                 BorderBrush="#555" BorderThickness="1"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
